generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

/// Short-lived, hashed email verification codes used by sensitive flows.
enum VerificationCodePurpose {
  PASSWORD_RESET
  DATA_RESET
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  BKASH
  NAGAD
  CARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  ORDER
  PAYMENT
  PRODUCT
  SYSTEM
  ACCOUNT
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
  WITHDRAWAL
  REFUND
}

enum ExpenseCategory {
  PRODUCT_PURCHASE
  EMPLOYEE_SALARY
  SHOP_RENT
  ELECTRICITY_BILL
  INTERNET_BILL
  WATER_BILL
  GAS_BILL
  TRANSPORT
  DELIVERY
  MARKETING
  ADVERTISING
  MAINTENANCE
  OFFICE_SUPPLIES
  TAX
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  ORDER_SALE
  ORDER_CANCEL
  ORDER_RETURN
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(120)
  email           String       @unique @db.VarChar(255)
  password        String?
  phone           String?      @db.VarChar(30)
  image           String?      @db.Text
  role            Role         @default(CUSTOMER)
  status          UserStatus   @default(ACTIVE)
  provider        AuthProvider @default(LOCAL)
  googleId        String?      @unique @db.VarChar(191)
  isActive        Boolean      @default(true)
  isEmailVerified Boolean      @default(false)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  addresses               Address[]
  orders                  Order[]
  reviews                 Review[]
  wishlist                Wishlist[]
  cart                    Cart?
  notifications           Notification[]
  auditLogs               AuditLog[]
  expensesCreated         Expense[]              @relation("ExpenseCreatedBy")
  expensesApproved        Expense[]              @relation("ExpenseApprovedBy")
  investments             Investment[]
  employeesCreated        Employee[]             @relation("EmployeeCreatedBy")
  salaryPaymentsCreated   SalaryPayment[]        @relation("SalaryPaymentCreatedBy")
  financialTransactions   FinancialTransaction[]
  inventoryLogs           InventoryLog[]
  productDiscountsCreated ProductDiscount[]      @relation("ProductDiscountCreatedBy")
  paymentsCollected       Payment[]              @relation("PaymentCollectedBy")
  verificationCodes       VerificationCode[]
  notes                   Note[]

  @@index([role])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("users")
}

/// Personal notes kept by shop staff in the dashboard notepad.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String?  @db.VarChar(120)
  content   String   @db.Text
  color     String   @default("#facc15") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("notes")
}

/// Hashed one-time codes for password resets and the super-admin data wipe.
/// A code is consumed (deleted) as soon as it is used successfully.
model VerificationCode {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @db.Uuid
  email       String                  @db.VarChar(255)
  purpose     VerificationCodePurpose
  codeHash    String
  attempts    Int                     @default(0)
  maxAttempts Int                     @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(160)
  description String?  @db.Text
  image       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products             Product[]
  homeCategorySections HomeCategorySection[]

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(160)
  logo        String?  @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
  @@map("brands")
}

enum BannerPlacement {
  HERO
  PROMO
}

model Banner {
  id        String          @id @default(uuid()) @db.Uuid
  title     String          @db.VarChar(160)
  subtitle  String?         @db.VarChar(300)
  imageUrl  String          @db.Text
  publicId  String?         @unique @db.VarChar(255)
  linkUrl   String?         @db.Text
  placement BannerPlacement @default(PROMO)
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
  @@index([isActive])
  @@map("banners")
}

/// Singleton row (id = "default") holding storefront presentation settings.
model SiteSettings {
  id                   String   @id @default("default") @db.VarChar(40)
  siteName             String?  @db.VarChar(120)
  navbarLogoUrl        String?  @db.Text
  navbarLogoPublicId   String?  @db.VarChar(255)
  showHero             Boolean  @default(true)
  showProductFinder    Boolean  @default(true)
  showMiddleCategories Boolean  @default(true)
  showCategorySections Boolean  @default(true)
  showNewArrivals      Boolean  @default(true)
  showBrands           Boolean  @default(true)
  showPromoBanners     Boolean  @default(true)
  showNewsletter       Boolean  @default(true)
  /// Dashboard-controlled payment method availability. Defaults keep existing
  /// installs unchanged; env configuration remains a hard capability cap.
  codEnabled           Boolean  @default(true)
  bkashEnabled         Boolean  @default(true)
  nagadEnabled         Boolean  @default(true)
  stripeEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categorySections HomeCategorySection[]

  @@map("site_settings")
}

/// Per-category visibility of the home page category sections.
model HomeCategorySection {
  id         String   @id @default(uuid()) @db.Uuid
  settingsId String   @db.VarChar(40)
  categoryId String   @db.Uuid
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([settingsId, categoryId])
  @@index([settingsId, sortOrder])
  @@map("home_category_sections")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @db.VarChar(200)
  slug              String        @unique @db.VarChar(220)
  sku               String        @unique @db.VarChar(80)
  description       String        @db.Text
  shortDescription  String?       @db.VarChar(500)
  price             Decimal       @db.Decimal(12, 2)
  discountPrice     Decimal?      @db.Decimal(12, 2)
  costPrice         Decimal?      @db.Decimal(12, 2)
  purchasePrice     Decimal       @default(0) @db.Decimal(12, 2)
  stock             Int           @default(0)
  minimumStockLevel Int           @default(5)
  soldCount         Int           @default(0)
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  categoryId        String        @db.Uuid
  brandId           String?       @db.Uuid
  modelUrl          String?       @db.Text
  sizes             Json?
  colors            Json?
  positionX         Float         @default(0)
  positionY         Float         @default(0)
  positionZ         Float         @default(0)
  rotationX         Float         @default(0)
  rotationY         Float         @default(0)
  rotationZ         Float         @default(0)
  scale             Float         @default(1)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems Wishlist[]
  orderItems    OrderItem[]
  reviews       Review[]
  inventoryLogs InventoryLog[]
  discount      ProductDiscount?

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([price])
  @@index([title])
  @@index([stock])
  @@index([createdAt])
  @@map("products")
}

model ProductDiscount {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @unique @db.Uuid
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdById   String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProductDiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
  @@map("product_discounts")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  imageUrl  String   @db.Text
  publicId  String?  @unique @db.VarChar(255)
  altText   String?  @db.VarChar(255)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @db.Uuid
  productId     String   @db.Uuid
  /// Empty string means "no selection" so the composite unique key also works
  /// for products without variants (Postgres treats NULLs as distinct).
  selectedSize  String   @default("") @db.VarChar(60)
  selectedColor String   @default("") @db.VarChar(60)
  quantity      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedSize, selectedColor])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  fullName    String   @db.VarChar(120)
  phone       String   @db.VarChar(30)
  division    String?  @db.VarChar(120)
  district    String   @db.VarChar(120)
  area        String?  @db.VarChar(120)
  addressLine String   @db.Text
  postalCode  String?  @db.VarChar(20)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([isDefault])
  @@map("addresses")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  orderNumber      String        @unique @db.VarChar(40)
  userId           String        @db.Uuid
  addressId        String?       @db.Uuid
  couponId         String?       @db.Uuid
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost     Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  totalProductCost Decimal       @default(0) @db.Decimal(12, 2)
  grossProfit      Decimal       @default(0) @db.Decimal(12, 2)
  netProfit        Decimal       @default(0) @db.Decimal(12, 2)
  refundedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod
  receiptNumber    String?       @unique @db.VarChar(40)
  receiptUrl       String?       @db.Text
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payment       Payment?
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([couponId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  productId      String?  @db.Uuid
  productName    String   @db.VarChar(220)
  productImage   String?  @db.Text
  sku            String?  @db.VarChar(80)
  /// Size and colour chosen by the customer at add-to-cart time.
  size           String?  @db.VarChar(60)
  color          String?  @db.VarChar(60)
  unitPrice      Decimal  @db.Decimal(12, 2)
  originalPrice  Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  finalUnitPrice Decimal  @default(0) @db.Decimal(12, 2)
  purchasePrice  Decimal  @default(0) @db.Decimal(12, 2)
  quantity       Int
  totalPrice     Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  productCost    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  transactionId     String?       @unique @db.VarChar(120)
  providerPaymentId String?       @db.VarChar(200)
  providerReference String?       @db.VarChar(160)
  providerResponse  Json?
  idempotencyKey    String?       @unique @db.VarChar(160)
  paidAt            DateTime?
  collectedById     String?       @db.Uuid
  collectedByName   String?       @db.VarChar(120)
  collectedAt       DateTime?
  collectionNote    String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedBy User? @relation("PaymentCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([method])
  @@index([providerPaymentId])
  @@index([collectedById])
  @@index([createdAt])
  @@map("payments")
}

model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique @db.VarChar(50)
  description     String?   @db.Text
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(12, 2)
  minimumAmount   Decimal?  @db.Decimal(12, 2)
  maxDiscount     Decimal?  @db.Decimal(12, 2)
  usageLimit      Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders Order[]

  @@index([isActive])
  @@index([createdAt])
  @@map("coupons")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  productId  String   @db.Uuid
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  orderId   String?          @db.Uuid
  /// "ORDER_PLACED" identifies a new incoming order for the shop/admin inbox.
  eventType String?          @db.VarChar(40)
  title     String           @db.VarChar(200)
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([eventType])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Singleton row (id = "default") holding printable order-receipt branding.
model ReceiptSettings {
  id               String   @id @default("default") @db.VarChar(40)
  storeName        String?  @db.VarChar(160)
  tagline          String?  @db.VarChar(240)
  logoUrl          String?  @db.Text
  footerNote       String?  @db.Text
  contactPhone     String?  @db.VarChar(80)
  contactEmail     String?  @db.VarChar(160)
  contactAddress   String?  @db.Text
  showLogo         Boolean  @default(true)
  showSize         Boolean  @default(true)
  showColor        Boolean  @default(true)
  showPaymentMethod Boolean @default(true)
  showTransactionId Boolean @default(true)
  showCustomer     Boolean  @default(true)
  showShippingAddress Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("receipt_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  action      String   @db.VarChar(80)
  entity      String   @db.VarChar(80)
  entityId    String?  @db.VarChar(120)
  description String?  @db.Text
  oldData     Json?
  newData     Json?
  ipAddress   String?  @db.VarChar(80)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Expense {
  id           String          @id @default(uuid()) @db.Uuid
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String?         @db.Text
  expenseDate  DateTime        @default(now())
  dueDate      DateTime?
  isPaid       Boolean         @default(true)
  paidAt       DateTime?
  receiptUrl   String?         @db.Text
  status       ExpenseStatus   @default(APPROVED)
  createdById  String          @db.Uuid
  approvedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy     User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  salaryPayment SalaryPayment?

  @@index([category])
  @@index([status])
  @@index([isPaid])
  @@index([expenseDate])
  @@index([dueDate])
  @@index([createdById])
  @@map("expenses")
}

model Investment {
  id             String   @id @default(uuid()) @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  source         String   @db.VarChar(200)
  description    String?  @db.Text
  investmentDate DateTime @default(now())
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([investmentDate])
  @@index([createdById])
  @@map("investments")
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(120)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(30)
  position      String   @db.VarChar(120)
  department    String?  @db.VarChar(120)
  monthlySalary Decimal  @db.Decimal(12, 2)
  joiningDate   DateTime
  isActive      Boolean  @default(true)
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User?           @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  salaries  SalaryPayment[]

  @@index([isActive])
  @@index([position])
  @@index([createdAt])
  @@map("employees")
}

model SalaryPayment {
  id          String       @id @default(uuid()) @db.Uuid
  employeeId  String       @db.Uuid
  month       Int
  year        Int
  amount      Decimal      @db.Decimal(12, 2)
  bonus       Decimal      @default(0) @db.Decimal(12, 2)
  deduction   Decimal      @default(0) @db.Decimal(12, 2)
  finalAmount Decimal      @db.Decimal(12, 2)
  status      SalaryStatus @default(PENDING)
  paymentDate DateTime?
  notes       String?      @db.Text
  createdById String?      @db.Uuid
  expenseId   String?      @unique @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("SalaryPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@index([status])
  @@map("salary_payments")
}

model FinancialTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType
  category        String          @db.VarChar(80)
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime        @default(now())
  description     String?         @db.Text
  referenceType   String?         @db.VarChar(80)
  referenceId     String?         @db.VarChar(120)
  createdById     String?         @db.Uuid
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([referenceType, referenceId, transactionType])
  @@index([transactionType])
  @@index([category])
  @@index([date])
  @@index([createdById])
  @@map("financial_transactions")
}

model InventoryLog {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @db.Uuid
  movementType  InventoryMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?               @db.Text
  referenceType String?               @db.VarChar(80)
  referenceId   String?               @db.VarChar(120)
  createdById   String?               @db.Uuid
  createdAt     DateTime              @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@map("inventory_logs")
}
