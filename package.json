{
  "name": "ecommerce-3d-server",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready 3D e-commerce backend built with Node.js, TypeScript, Express, PostgreSQL and Prisma.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --experimental-test-module-mocks tests/gateway-response.test.ts tests/bkash.test.ts tests/nagad.test.ts tests/stripe.test.ts tests/payment-service.test.ts tests/order-checkout-and-bkash-create.test.ts",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema ./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ./prisma/schema.prisma",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate --schema ./prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
