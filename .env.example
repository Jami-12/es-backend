# ─────────────────────────────────────────────────────────────
# Express + Prisma API — environment template
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Active values below are LOCAL DEVELOPMENT defaults. After `vercel --prod`
# generates the new URLs, replace the PLACEHOLDERS in the "Vercel" comments
# below in BOTH this file (for reference) and the Vercel Project Settings ->
# Environment Variables for Production/Preview. Do NOT commit real secrets.
#
# No OpenAI / AI packages are used by this server.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL / Prisma connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode special characters in the password (for example @ becomes %40).
# Omit ?schema=public if your PostgreSQL host or pooler rejects the schema parameter.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce_db?schema=public"

JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ── URLs and CORS ────────────────────────────────────────────
# FRONTEND_URL / CLIENT_URL = the NEXT.JS STOREFRONT origin.
# PUBLIC_BASE_URL           = THIS BACKEND origin (never the storefront).
#
# VERCEL, VERCEL_URL and VERCEL_BRANCH_URL are injected automatically by
# Vercel — never set them manually. When the explicit URLs below are left
# unset/blank on Vercel, the server derives the active HTTPS origin from those
# variables (or from the incoming request host/origin on *.vercel.app).
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Vercel (client): FRONTEND_URL=https://<NEW_CLIENT_VERCEL_URL>
# Vercel (client): CLIENT_URL=https://<NEW_CLIENT_VERCEL_URL>

# Comma-separated allowed browser origins. Wildcard host patterns are supported.
# Vercel (server): CORS_ORIGIN=https://<NEW_CLIENT_VERCEL_URL>,https://*.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Vercel (server): PUBLIC_BASE_URL=https://<NEW_SERVER_VERCEL_URL>
PUBLIC_BASE_URL=http://localhost:4000

TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Store metadata (fallbacks only; Dashboard settings win) ──
STORE_NAME="3D Commerce"
STORE_ADDRESS="Dhaka, Bangladesh"
STORE_PHONE="+8801000000000"
STORE_EMAIL="support@example.com"
STORE_CURRENCY=BDT

# ── Email delivery (Nodemailer) ──────────────────────────────
# Leave SMTP_ENABLED=false until every value below is filled in.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ── Shipping / inventory ─────────────────────────────────────
# Shipping is stored and reported separately from product subtotal/revenue.
SHIPPING_FLAT_RATE=60
FREE_SHIPPING_THRESHOLD=1000
LOW_STOCK_THRESHOLD=5

# Optional shared secret for the generic provider webhook.
# Leave unset to keep that endpoint disabled.
# PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# ── Super admin seed ─────────────────────────────────────────
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
# Required. At least 12 characters. Replace this placeholder before starting.
SUPER_ADMIN_PASSWORD="CHANGE_THIS_SECURELY"
# Set to true once to reset an existing super-admin password during seeding.
SEED_RESET_SUPER_ADMIN_PASSWORD=true

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel (server): GOOGLE_CALLBACK_URL=https://<NEW_SERVER_VERCEL_URL>/api/v1/auth/google/callback
# Vercel (client): GOOGLE_SUCCESS_REDIRECT_URL=https://<NEW_CLIENT_VERCEL_URL>/auth/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback

# ── bKash Tokenized Checkout sandbox ─────────────────────────
# Set BKASH_ENABLED=true only after all bKash values are filled in.
#
# BKASH_CALLBACK_URL is the MERCHANT CALLBACK URL registered with bKash. It
# must be a clean absolute URL pointing only to
# /api/v1/payments/bkash/callback on THIS backend: no query string, no hash,
# no trailing slash and no localhost in production. bKash appends paymentID and
# status itself, so never add ?orderId=... here. If omitted, the server builds
# the same URL from the PUBLIC_BASE_URL / active Vercel origin.
#
# The callback must be publicly reachable by bKash; localhost only works
# together with a tunnel such as ngrok during local testing.
#
# Test credentials below are bKash's published sandbox credentials. Replace
# them with the credentials issued to your own merchant account.
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Vercel (server): BKASH_CALLBACK_URL=https://<NEW_SERVER_VERCEL_URL>/api/v1/payments/bkash/callback
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/payments/bkash/callback

# ── Nagad ────────────────────────────────────────────────────
# NAGAD_SIMULATION is dev-only and ignored in production.
NAGAD_ENABLED=false
NAGAD_SIMULATION=false
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
# Vercel (server): NAGAD_CALLBACK_URL=https://<NEW_SERVER_VERCEL_URL>/api/v1/payments/nagad/callback
NAGAD_CALLBACK_URL=http://localhost:4000/api/v1/payments/nagad/callback

# ── Stripe / card ────────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Safe public key used by the storefront to initialise Stripe Elements.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match STORE_CURRENCY.
STRIPE_CURRENCY=BDT

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce-products
