NODE_ENV=development
PORT=4000

# PostgreSQL / Prisma connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode special characters in the password (for example @ becomes %40).
# Omit ?schema=public if your PostgreSQL host or pooler rejects the schema parameter.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce_db?schema=public"

JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

STORE_NAME="3D Commerce"
STORE_ADDRESS="Dhaka, Bangladesh"
STORE_PHONE="+8801000000000"
STORE_EMAIL="support@example.com"
STORE_CURRENCY=BDT

# Email delivery (Nodemailer). Leave SMTP_ENABLED=false to disable email
# features; the server still starts and the affected endpoints return a clear
# 503 response instead of crashing. Set SMTP_ENABLED=true only after filling in
# every value below. Use port 465 with SMTP_SECURE=true, or 587 with false.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

SHIPPING_FLAT_RATE=60
FREE_SHIPPING_THRESHOLD=1000
LOW_STOCK_THRESHOLD=5

# Optional shared secret for the generic provider webhook.
# Leave unset to keep that endpoint disabled.
# PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
# Required. At least 12 characters. Replace this placeholder before starting.
SUPER_ADMIN_PASSWORD="CHANGE_THIS_SECURELY"
# Set to true once to reset an existing super-admin password during seeding.
SEED_RESET_SUPER_ADMIN_PASSWORD=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback

# bKash Tokenized Checkout sandbox (official sandbox host).
# Set BKASH_ENABLED=true only after all bKash values are filled in.
# The callback URL must be publicly reachable by bKash; localhost only works
# together with a tunnel such as ngrok during local testing.
#
# bKash publishes shared test credentials for the Tokenized Checkout sandbox:
#   app key    4f6o0cjiki2rfm34kfdadl1eqq
#   app secret 2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
#   username   sandboxTokenizedUser02
#   password   sandboxTokenizedUser02@12345
# Replace them with the credentials issued to your own merchant account.
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Local development value. Vercel/production must be the public HTTPS URL:
# https://<your-deployed-backend>/api/v1/payments/bkash/callback
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/payments/bkash/callback

# Nagad classic sandbox. The classic endpoint uses HTTP on port 10080.
# Set NAGAD_ENABLED=true only after all Nagad values are filled in.
#
# Dev-only simulation: set NAGAD_SIMULATION=true to test the Nagad redirect ->
# callback -> verify flow locally without the live sandbox (which is often
# unreachable outside Bangladesh). It is ignored in production. When it is on,
# the NAGAD_* credentials below are not required.
NAGAD_ENABLED=false
NAGAD_SIMULATION=false
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_CALLBACK_URL=http://localhost:4000/api/v1/payments/nagad/callback

# Set STRIPE_ENABLED=true only after the secret key, publishable key and
# webhook secret are filled in.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Safe public key used by the storefront to initialise Stripe Elements.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match STORE_CURRENCY.
STRIPE_CURRENCY=BDT

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce-products
